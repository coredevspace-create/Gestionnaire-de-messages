# ---------- Indispensable sur Vercel ----------
# Base Postgres (Vercel > Storage > Neon). Vercel remplit DATABASE_URL automatiquement.
# Sans elle : base temporaire (PGlite) — OK en local, données perdues sur Vercel.
DATABASE_URL=
# Stockage des images/vidéos (Vercel > Storage > Blob). Rempli automatiquement par Vercel.
# Sans lui : fichiers locaux — OK en local, perdus sur Vercel.
# (ou BLOB_STORE_ID, ajouté par les nouvelles intégrations Blob)
BLOB_READ_WRITE_TOKEN=

# ---------- IA ----------
# Si une clé manque => mode SIMULATION (images et clips factices, gratuit)
OPENAI_API_KEY=
XAI_API_KEY=
# Forcer la simulation même avec des clés (1 = oui)
AI_MOCK=

# Laisser vide = choix automatique
OPENAI_TEXT_MODEL=
# Laisser vide = choix automatique (gpt-image-2, puis gpt-image-2.5-*)
OPENAI_IMAGE_MODEL=
# grok-imagine-video (base, moins cher) ou grok-imagine-video-1.5
XAI_VIDEO_MODEL=grok-imagine-video
XAI_VIDEO_RESOLUTION=480p
# Durée d'un plan (secondes)
CLIP_SECONDS=8

# ---------- Application ----------
# Crédits offerts à l'inscription
STARTER_CREDITS=30
# Emails ayant accès à /admin (séparés par des virgules)
ADMIN_EMAILS=
# URL publique du site (optionnel, sinon déduite de la requête)
APP_URL=
