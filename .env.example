# Clés API (si absentes => mode SIMULATION : images et clips factices générés localement avec ffmpeg)
OPENAI_API_KEY=
XAI_API_KEY=

# Forcer le mode simulation même avec des clés (1 = oui)
AI_MOCK=

# Modèles (modifiables sans toucher au code)
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-1
XAI_VIDEO_MODEL=grok-imagine-video-1.5
XAI_VIDEO_RESOLUTION=480p
# Durée max d'un clip Grok (secondes)
CLIP_SECONDS=10

# Dossier des données (base SQLite + médias)
DATA_DIR=./data

# Crédits offerts à l'inscription
STARTER_CREDITS=30
# Emails ayant accès à /admin (séparés par des virgules)
ADMIN_EMAILS=
